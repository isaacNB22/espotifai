# Variables de entorno (contienen API keys y secretos)
server/.env

# Datos generados en tiempo de ejecución
server/data/
server/downloads/

# Dependencias de Node.js
node_modules/
server/node_modules/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Flutter — plataformas no usadas en desarrollo Windows
# (se incluyen para poder compilar en otros entornos)
# app/ios/   <- NO excluir, necesario para compilar en Mac
# app/android/ <- NO excluir, necesario para compilar en Android

# Flutter — archivos generados de Android (se regeneran con gradle)
app/android/.gradle/
app/android/app/build/
app/android/build/
app/android/local.properties

# Flutter — archivos generados de iOS (se regeneran con pod install)
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec

# Flutter — archivos generados de Windows (se regeneran con flutter pub get)
app/windows/flutter/generated_plugin_registrant.cc
app/windows/flutter/generated_plugin_registrant.h
app/windows/flutter/generated_plugins.cmake
app/windows/flutter/ephemeral/
app/windows/flutter/CMakeLists.txt

# Flutter — boilerplate del runner de Windows (generado por Flutter)
app/windows/runner/flutter_window.cpp
app/windows/runner/flutter_window.h
app/windows/runner/main.cpp
app/windows/runner/resource.h
app/windows/runner/runner.exe.manifest
app/windows/runner/Runner.rc
app/windows/runner/utils.cpp
app/windows/runner/utils.h
app/windows/runner/win32_window.cpp
app/windows/runner/win32_window.h
app/windows/runner/resources/

# Flutter — metadatos y caché
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.dart_tool/
app/.metadata
app/README.md
app/analysis_options.yaml

# Archivos temporales del servidor (fragmentos de yt-dlp/ffmpeg)
server/--Frag*
server/*.part
server/*.tmp

roadmap.md
