# ────────────────────────────────────────────
#  espotifai — Variables de entorno
#  Copia este archivo a .env y completa los valores
# ────────────────────────────────────────────

# Puerto del servidor (por defecto 3000)
PORT=3000

# Clave de YouTube Data API v3
# Obtén la tuya en: https://console.cloud.google.com/
# → Crear proyecto → Habilitar "YouTube Data API v3" → Crear credencial API Key
YOUTUBE_API_KEY=AQUI_VA_TU_API_KEY

# Carpeta donde se guardan los archivos descargados (relativa al /server)
# Esta carpeta actúa como tu "nube personal"
DOWNLOADS_DIR=./downloads
